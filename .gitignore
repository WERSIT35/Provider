node_modules/
npm-debug.log*
.env

# Claude Code local session/memory data
.claude/projects/

# Claude local settings - contains sensitive tokens and local paths
.claude/settings.local.json
.claude/settings.*.json

# demo-operator SQLite database (players, wallet ledger, staff sessions)
demo-operator/data/

# Release artifacts (e.g. the lab compliance package) are built locally, never committed.
*.zip

# Production secrets for the hosted platform (infra/.env.prod.example is the template).
infra/.env.prod

# Sound audition: candidate recordings and files dropped in for auditioning are
# not committed (candidates.json lists them; picks are copied into art-src/audio/
# when built).
art-src/audio/candidates/*.ogg
art-src/audio/incoming/*
!art-src/audio/incoming/README.md

# Bench history (latest results live in qa/bench/*.json)
qa/bench/runs/

# Static demo site, built by tools/build-demo.mjs (Vercel/Netlify build it themselves).
dist-demo/
