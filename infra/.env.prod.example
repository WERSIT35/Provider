# Template for .env.prod (git-ignored). `node gen-secrets.mjs > .env.prod` fills every secret.
# The platform refuses to boot in staging/production if any secret is left at its dev default.

# Public hostname Caddy serves (DNS A record → this server), e.g. rgs.example.com
RGS_DOMAIN=

# staging until lab certification + licence; then production (same boot guards).
NODE_ENV=staging
LOG_LEVEL=info

POSTGRES_PASSWORD=

LAUNCH_TOKEN_SECRET=
SESSION_TOKEN_SECRET=
ADMIN_TOKEN_SECRET=

BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
TOTP_ISSUER=Lumina Games RGS

# The ACTIVE Ed25519 signing key (exports + every ledger row): PKCS#8 PEM on ONE line with
# literal \n (the signer unescapes it). Keep a private copy. Its public half is stored in
# signing_keys, so old signatures stay verifiable even after it is replaced.
# Rotation: put a new key here and restart; the old one is retired automatically
# (platform/GUIDE.md §4e). A retired key can never be put back.
EXPORT_SIGNING_KEY=
# Optional planned end of life (ISO 8601); staging/production refuse to boot after it.
# Leave the line commented out when unused: an empty value is not a valid date.
# EXPORT_SIGNING_KEY_EXPIRES_AT=2027-10-01T00:00:00Z

# Bearer token for GET /metrics (min 16 chars).
METRICS_TOKEN=
